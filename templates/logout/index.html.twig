{% extends 'base.html.twig' %}

{% block title %}Signed Out - VLM Content Manager{% endblock %}

{% block body %}
<div class="card" style="max-width: 440px; margin: 4rem auto; text-align: center; padding: 3rem 2rem;">
    <div style="width: 64px; height: 64px; background: var(--success-bg); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin: 0 auto 1.4rem;">👋</div>

    <h2>You've been signed out</h2>
    <p style="color: var(--text-muted); margin-top: 0.6rem; line-height: 1.6;">
        Thanks for using VLM Content Manager.<br>See you again soon!
    </p>

    <div style="display: flex; gap: 0.8rem; justify-content: center; margin-top: 2rem;">
        <a href="{{ path('page_login') }}" class="btn">Sign In Again</a>
        <a href="{{ path('home') }}" class="btn btn-secondary">Go to Home</a>
    </div>
</div>

<script>
// Obriši token čim se stranica učita (radi i ako netko dođe direktno na /logout)
localStorage.removeItem('jwt_token');
</script>
{% endblock %}