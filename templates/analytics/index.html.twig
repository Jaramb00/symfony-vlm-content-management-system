{% extends 'base.html.twig' %}

{% block title %}Analytics - Latency Statistics{% endblock %}

{% block body %}
<div style="margin-bottom: 1.5rem;">
    <h1>Performance Analytics</h1>
    <p style="color: var(--text-muted); margin-top: 0.3rem;">Quantitative evaluation of AI API latency</p>
</div>

<div id="loading"><div class="spinner"></div></div>

<div id="content" style="display: none;">

    <!-- Overview Cards -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
        <div class="card" style="padding: 1.4rem;">
            <p style="color: var(--text-muted); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Total Requests</p>
            <p style="font-size: 2.1rem; font-weight: 800; margin-top: 0.4rem;" id="totalRequests">-</p>
        </div>
        <div class="card" style="padding: 1.4rem;">
            <p style="color: var(--text-muted); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Avg Latency</p>
            <p style="font-size: 2.1rem; font-weight: 800; margin-top: 0.4rem; color: var(--primary);"><span id="avgLatency">-</span><span style="font-size: 1rem; color: var(--text-muted); font-weight: 600;"> ms</span></p>
        </div>
        <div class="card" style="padding: 1.4rem;">
            <p style="color: var(--text-muted); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Min Latency</p>
            <p style="font-size: 2.1rem; font-weight: 800; margin-top: 0.4rem; color: var(--success);"><span id="minLatency">-</span><span style="font-size: 1rem; color: var(--text-muted); font-weight: 600;"> ms</span></p>
        </div>
        <div class="card" style="padding: 1.4rem;">
            <p style="color: var(--text-muted); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Max Latency</p>
            <p style="font-size: 2.1rem; font-weight: 800; margin-top: 0.4rem; color: var(--danger);"><span id="maxLatency">-</span><span style="font-size: 1rem; color: var(--text-muted); font-weight: 600;"> ms</span></p>
        </div>
    </div>

    <!-- Latency Over Time -->
    <div class="card" style="margin-top: 1.2rem;">
        <h3>Latency Over Time</h3>
        <canvas id="latencyChart" style="margin-top: 1rem; max-height: 320px;"></canvas>
    </div>

    <!-- Size vs Latency -->
    <div class="card" style="margin-top: 1.2rem;">
        <h3>Image Size vs Latency Correlation</h3>
        <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.3rem;">Relationship between image size (KB) and API response time (ms)</p>
        <canvas id="scatterChart" style="margin-top: 1rem; max-height: 320px;"></canvas>
    </div>

    <!-- By Model -->
    <div class="card" style="margin-top: 1.2rem;">
        <h3>Statistics by Model</h3>
        <table>
            <thead>
                <tr>
                    <th>Model</th>
                    <th style="text-align: center;">Requests</th>
                    <th style="text-align: center;">Avg (ms)</th>
                    <th style="text-align: center;">Min (ms)</th>
                    <th style="text-align: center;">Max (ms)</th>
                </tr>
            </thead>
            <tbody id="modelTable"></tbody>
        </table>
    </div>

    <!-- By Image -->
    <div class="card" style="margin-top: 1.2rem;">
        <h3>Latency by Image</h3>
        <table>
            <thead>
                <tr>
                    <th>Filename</th>
                    <th style="text-align: center;">Size (KB)</th>
                    <th style="text-align: center;">Latency (ms)</th>
                    <th>Model</th>
                </tr>
            </thead>
            <tbody id="imageSizeTable"></tbody>
        </table>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const token = localStorage.getItem('jwt_token');

if (!token) {
    window.location.href = '/login';
}

async function loadAnalytics() {
    try {
        const response = await fetch('/api/analytics/latency', {
            headers: { 'Authorization': 'Bearer ' + token }
        });

        if (response.status === 401) {
            localStorage.removeItem('jwt_token');
            window.location.href = '/login';
            return;
        }

        const data = await response.json();

        document.getElementById('totalRequests').textContent = data.total_requests;
        document.getElementById('avgLatency').textContent = Math.round(data.latency.average_ms);
        document.getElementById('minLatency').textContent = data.latency.min_ms;
        document.getElementById('maxLatency').textContent = data.latency.max_ms;

        // Model table
        document.getElementById('modelTable').innerHTML = data.by_model.map(m => `
            <tr>
                <td style="font-weight: 600;">${m.model}</td>
                <td style="text-align: center;">${m.total}</td>
                <td style="text-align: center;">${Math.round(m.avg_latency_ms)}</td>
                <td style="text-align: center;">${m.min_latency_ms}</td>
                <td style="text-align: center;">${m.max_latency_ms}</td>
            </tr>
        `).join('');

        // Samo zapisi koji imaju veličinu slike (filtrira stare null zapise)
        const withSize = data.by_image_size.filter(r => r.size_bytes > 0);

        // Line chart — latencija kroz vrijeme
        new Chart(document.getElementById('latencyChart'), {
            type: 'line',
            data: {
                labels: data.over_time.map(r => r.date),
                datasets: [{
                    label: 'Latency (ms)',
                    data: data.over_time.map(r => r.latency_ms),
                    borderColor: '#6366f1',
                    backgroundColor: 'rgba(99, 102, 241, 0.08)',
                    tension: 0.35,
                    fill: true,
                    pointBackgroundColor: '#6366f1',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, title: { display: true, text: 'Latency (ms)' }, grid: { color: '#f1f5f9' } },
                    x: { title: { display: true, text: 'Time' }, grid: { display: false } }
                }
            }
        });

        // Scatter — veličina vs latencija
        new Chart(document.getElementById('scatterChart'), {
            type: 'scatter',
            data: {
                datasets: [{
                    label: 'Image',
                    data: withSize.map(r => ({ x: r.size_kb, y: r.latency_ms })),
                    backgroundColor: 'rgba(139, 92, 246, 0.65)',
                    pointRadius: 7,
                    pointHoverRadius: 9
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => `${withSize[ctx.dataIndex].filename}: ${ctx.parsed.x} KB → ${ctx.parsed.y} ms`
                        }
                    }
                },
                scales: {
                    x: { title: { display: true, text: 'Image Size (KB)' }, grid: { color: '#f1f5f9' } },
                    y: { title: { display: true, text: 'Latency (ms)' }, beginAtZero: true, grid: { color: '#f1f5f9' } }
                }
            }
        });

        // Image table
        document.getElementById('imageSizeTable').innerHTML = withSize.map(r => `
            <tr>
                <td style="font-family: monospace; font-size: 0.85rem;">${r.filename}</td>
                <td style="text-align: center;">${r.size_kb}</td>
                <td style="text-align: center; font-weight: 600;">${r.latency_ms}</td>
                <td style="color: var(--text-muted);">${r.model}</td>
            </tr>
        `).join('');

        document.getElementById('loading').style.display = 'none';
        document.getElementById('content').style.display = 'block';
    } catch {
        document.getElementById('loading').style.display = 'none';
    }
}

loadAnalytics();
</script>
{% endblock %}