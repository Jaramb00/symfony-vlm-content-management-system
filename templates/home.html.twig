{% extends 'base.html.twig' %}

{% block title %}Home - VLM Content Manager{% endblock %}

{% block body %}
<div class="card" style="text-align: center;">
    <h1>Welcome to VLM Content Manager</h1>
    <p style="margin: 1.5rem 0; color: #666;">Upload images and get AI-powered analysis using Vision-Language Models</p>
    
    {% if app.user %}
        <a href="{{ path('page_dashboard') }}" class="btn">Go to Dashboard</a>
    {% else %}
        <div>
            <a href="{{ path('page_register') }}" class="btn">Get Started</a>
            <a href="{{ path('page_login') }}" class="btn" style="background: #95a5a6; margin-left: 1rem;">Login</a>
        </div>
    {% endif %}
</div>
{% endblock %}