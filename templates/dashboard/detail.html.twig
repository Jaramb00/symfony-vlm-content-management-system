{% extends 'base.html.twig' %}

{% block title %}Request Details{% endblock %}

{% block body %}
<a href="{{ path('page_dashboard') }}" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem; font-weight: 500;">← Back to Dashboard</a>

<div id="loading"><div class="spinner"></div></div>

<div id="content" style="display: none; margin-top: 1.2rem;">
    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <h1 id="title" style="font-size: 1.5rem;"></h1>
                <p id="description" style="color: var(--text-muted); margin-top: 0.4rem;"></p>
            </div>
            <span id="statusBadge"></span>
        </div>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 1rem;">Created <span id="created"></span></p>
    </div>

    <div id="processingNote" style="display: none;" class="card" >
        <div style="text-align: center; padding: 1rem;">
            <div class="spinner" style="margin: 0 auto 1rem;"></div>
            <h3>AI is analyzing your image…</h3>
            <p style="color: var(--text-muted); margin-top: 0.4rem; font-size: 0.9rem;">This page will update automatically</p>
        </div>
    </div>

    <div id="aiResult" style="display: none; margin-top: 1.2rem;" class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.8rem;">
            <h2>AI Analysis Result</h2>
            <div style="display: flex; gap: 1.4rem; font-size: 0.85rem; color: var(--text-muted);">
                <span>🤖 <strong id="model" style="color: var(--text);"></strong></span>
                <span>⏱️ <strong id="latency" style="color: var(--text);"></strong> ms</span>
            </div>
        </div>
        <div id="aiContent" style="margin-top: 1.4rem; line-height: 1.7; white-space: pre-wrap; background: var(--bg); padding: 1.4rem; border-radius: 9px; border: 1px solid var(--border);"></div>
    </div>

    <div id="failedNote" style="display: none; margin-top: 1.2rem;" class="alert alert-error">
        Analysis failed. Please return to the dashboard and try uploading the image again.
    </div>
</div>

<script>
const token = localStorage.getItem('jwt_token');
const requestId = {{ requestId }};
let pollTimer = null;

if (!token) {
    window.location.href = '/login';
}

async function loadDetails() {
    try {
        const reqRes = await fetch(`/api/content-request/${requestId}`, {
            headers: { 'Authorization': 'Bearer ' + token }
        });

        if (reqRes.status === 401) {
            localStorage.removeItem('jwt_token');
            window.location.href = '/login';
            return;
        }
        if (!reqRes.ok) {
            window.location.href = '/dashboard';
            return;
        }

        const reqData = await reqRes.json();

        document.getElementById('title').textContent = reqData.title;
        document.getElementById('description').textContent = reqData.description || '';
        document.getElementById('created').textContent = reqData.createdAt;
        document.getElementById('statusBadge').innerHTML = `<span class="badge badge-${reqData.status}">${reqData.status}</span>`;

        document.getElementById('loading').style.display = 'none';
        document.getElementById('content').style.display = 'block';

        const processingNote = document.getElementById('processingNote');
        const aiResult = document.getElementById('aiResult');
        const failedNote = document.getElementById('failedNote');

        processingNote.style.display = 'none';
        aiResult.style.display = 'none';
        failedNote.style.display = 'none';

        if (reqData.status === 'done') {
            const aiRes = await fetch(`/api/content-request/${requestId}/response`, {
                headers: { 'Authorization': 'Bearer ' + token }
            });
            if (aiRes.ok) {
                const aiData = await aiRes.json();
                document.getElementById('model').textContent = aiData.modelUsed;
                document.getElementById('latency').textContent = aiData.latencyMs;
                document.getElementById('aiContent').textContent = aiData.processedContent;
                aiResult.style.display = 'block';
            }
            clearTimeout(pollTimer);
        } else if (reqData.status === 'failed') {
            failedNote.style.display = 'block';
            clearTimeout(pollTimer);
        } else {
            // pending ili processing — prikaži poruku i provjeri opet za 4s
            processingNote.style.display = 'block';
            processingNote.style.marginTop = '1.2rem';
            pollTimer = setTimeout(loadDetails, 4000);
        }
    } catch {
        document.getElementById('loading').style.display = 'none';
    }
}

loadDetails();
</script>
{% endblock %}